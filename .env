# # ─────────────────────────────────────────────────────────────────
# # Phase 2 — .env configuration
# # Copy this file to .env and fill in your values.
# #
# # You need TWO service keys from BTP Cockpit:
# #   1. Service Manager (subaccount-admin plan)  → for service catalog + instances
# #   2. Cloud Management Service (central plan)  → for entitlements
# # ─────────────────────────────────────────────────────────────────

# # ── Service Manager service key ──────────────────────────────────
# # BTP Cockpit → Service Marketplace → Service Manager → subaccount-admin plan
# # (Same as Phase 1)

# BTP_CLIENT_ID=your-sm-client-id
# BTP_CLIENT_SECRET=your-sm-client-secret
# BTP_TOKEN_URL=https://your-subdomain.authentication.us10.hana.ondemand.com/oauth/token
# BTP_SM_URL=https://service-manager.cfapps.us10.hana.ondemand.com

# # ── Cloud Management Service (CIS) service key ───────────────────
# # BTP Cockpit → Service Marketplace → Cloud Management Service → central plan
# # Create a new service instance + service key for this
# # The clientid and clientsecret come from the new CIS service key JSON

# BTP_CIS_CLIENT_ID=your-cis-client-id
# BTP_CIS_CLIENT_SECRET=your-cis-client-secret

# # Usually the same token URL as above (same subdomain, different client)
# # Copy from your CIS service key: credentials.uaa.url + /oauth/token
# BTP_CIS_TOKEN_URL=https://your-subdomain.authentication.us10.hana.ondemand.com/oauth/token

# # ── Subaccount ────────────────────────────────────────────────────
# # BTP Cockpit → your subaccount → Overview → "Subaccount ID" field
# BTP_SUBACCOUNT_ID=your-subaccount-guid

# # ── API URLs ─────────────────────────────────────────────────────
# # Entitlements API is ALWAYS eu10 — even if your subaccount is us10/ap21
# # (It is a central/global service, not region-specific)
# BTP_ENTITLEMENTS_URL=https://entitlements-service.cfapps.eu10.hana.ondemand.com

# # Destination service follows YOUR subaccount region
# BTP_DESTINATION_URL=https://destination.cfapps.us10.hana.ondemand.com

# # ── Optional ─────────────────────────────────────────────────────
# # CACHE_TTL_SECONDS=300
